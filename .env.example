APP_NAME="Multi Tenant API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://multi-tenant-backend.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multi_tenant_central
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Prefer redis in production for tenant cache prefix isolation at scale
# CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Queue Stancl tenant lifecycle jobs (create/migrate/seed/delete). Defaults to false in local/testing.
# TENANCY_QUEUE_LIFECYCLE=true

# Billing
BILLING_GATEWAY=fake
BILLING_ENABLED_GATEWAYS=fake,stripe
BILLING_DEFAULT_CURRENCY=USD
BILLING_ENFORCE_LIMITS=true
# BILLING_REQUIRE_SUBSCRIPTION=false
# BILLING_AUTO_SUBSCRIBE_ON_PROVISION=true
# BILLING_DEFAULT_PLAN_SLUG=free
# BILLING_GRACE_DAYS=3
# BILLING_PRORATION_ENABLED=true
# BILLING_TRIAL_ENDING_SOON_DAYS=3
# BILLING_FAKE_WEBHOOK_SECRET=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=
# PAYSTACK_SECRET=
# FLUTTERWAVE_SECRET_HASH=

# Sanctum SPA stateful domains (comma-separated), if using cookie auth
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,multi-tenant-backend.test
